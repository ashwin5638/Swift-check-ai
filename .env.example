# Copy to .env and fill in. Never commit .env.
# Validate everything with:  npm run check:keys

# ---- LLM (Groq) --------------------------------------------------------
# https://console.groq.com/keys
# Check configured models still exist with: npm run check:models
GROQ_API_KEY=

# ---- Stock imagery (Pexels) -------------------------------------------
# https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- Facebook (Page video via Graph API v26) ----------------------------
# https://developers.facebook.com -> your app -> Page access token
# App needs pages_show_list, pages_read_engagement, pages_manage_posts.
# APP_ID is the numeric app id shown in the app dashboard.
FACEBOOK_APP_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: a user token with the same scopes. Used for the upload step; falls
# back to the Page token when blank.
FACEBOOK_USER_ACCESS_TOKEN=
# Leave blank to use the pinned default in server/config.js (v26.0).
FACEBOOK_GRAPH_VERSION=

# ---- LinkedIn (personal profile, Posts API) ----------------------------
# Scope required: w_member_social
# LINKEDIN_MEMBER_ID is the numeric part of urn:li:person:<id>
# Video additionally requires w_member_social video access; if the app is not
# approved for video the publisher falls back to a text post.
LINKEDIN_MEMBER_ID=
LINKEDIN_ACCESS_TOKEN=
# YYYYMM header version, no "v" prefix. Pinned default lives in server/config.js.
LINKEDIN_API_VERSION=

# ---- Telegram (optional) -----------------------------------------------
# Bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Server ------------------------------------------------------------
# HOST defaults to 127.0.0.1, which keeps the unauthenticated API off your LAN.
# Only set 0.0.0.0 if you have added real authentication in front of it.
HOST=
PORT=4000
