node_modules/
client/node_modules/
client/dist/
.env
.env.local
# The example files are documentation and must stay tracked. Negating them here
# keeps a newly added client/.env.example from being silently ignored, which is
# what happens with a bare `.env*` rule.
!.env.example
!client/.env.example
output/
logs/
*.log
# Runtime state, not source: the dedupe ledger, pending-post queue and run
# history. Written by server/lib/state.js, recreated empty on a fresh clone.
# Committing these ships one machine's run history to everyone.
state/
.DS_Store
Thumbs.db
test/tmp/
