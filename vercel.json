{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix client ci && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm ci --ignore-scripts",
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  },
  "functions": {
    "api/auth.js": { "maxDuration": 15 },
    "api/covered.js": { "maxDuration": 15 },
    "api/health.js": { "maxDuration": 15 },
    "api/captions/[id]/[platform].js": { "maxDuration": 15 },
    "api/pending/index.js": { "maxDuration": 15 },
    "api/pending/[id]/approve.js": { "maxDuration": 15 },
    "api/pending/[id]/reject.js": { "maxDuration": 15 },
    "api/runs/index.js": { "maxDuration": 15 },
    "api/runs/[id]/index.js": { "maxDuration": 15 },
    "api/runs/[id]/publish.js": { "maxDuration": 15 }
  }
}