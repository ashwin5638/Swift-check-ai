{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "node scripts/vercelPreflight.js && npm ci && npm --prefix client ci",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",

  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
