{
  "name": "swift-check-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Marine industry news -> branded 15s reel -> Facebook & LinkedIn. Fully automated on a $0 budget.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "playwright install chromium",
    "check:models": "node scripts/checkModels.js",
    "check:keys": "node scripts/checkKeys.js",
    "linkedin:whoami": "node scripts/linkedinWhoami.js",
    "telegram:chatid": "node scripts/telegramChatId.js",
    "run": "node server/orchestrator.js",
    "run:dry": "node server/orchestrator.js --dry",
    "publish:dashboard": "node scripts/publishDashboard.js",
    "server": "node server/index.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:server\" \"npm --prefix client run dev\"",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "groq-sdk": "^0.9.0",
    "playwright": "^1.49.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@vercel/blob": "^2.8.0",
    "concurrently": "^9.1.0"
  }
}
